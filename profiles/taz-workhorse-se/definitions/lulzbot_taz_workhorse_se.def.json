        "machine_start_gcode": {
            "default_value": ";This G-Code has been generated specifically for the LulzBot TAZ Workhorse with the SE 0.5 mm tool head\n;\n;SETTINGS\n;Nozzle diameter = {machine_nozzle_size}mm\n;Filament name = {material_brand} {material_name}\n;Filament type = {material_type} {material_diameter}mm\n;Extruder temp = {material_print_temperature}\n;Bed temp = {material_bed_temperature}\n;\n;The following lines can be uncommented for printer specific fine tuning.\n;More information can be found at https://marlinfw.org/meta/gcode/\n;M92 E420                                   ; set axis steps-per-unit\n;M906 E160                                  ; digipot motor current ((875mA-750)/5+135) = 160\n;M900 K0.0                                  ; set linear advance K factor\n;\nM73 P0                                      ; clear GLCD progress bar\nM75                                         ; start GLCD timer\nM117 Starting {jobname}...                  ; progress indicator message on LCD\nM107                                        ; disable fans\nM420 S0                                     ; disable previous leveling matrix\nG90                                         ; absolute positioning\nM82                                         ; set extruder to absolute mode\nG92 E0                                      ; set extruder position to 0\nM104 R{material_standby_temperature}        ; start extruder heating to wipe temp\nM140 S{material_bed_temperature_layer_0}    ; start bed heating up\nG28                                         ; home all axes\nM117 Heating...                             ; progress indicator message on LCD\nM109 R{material_standby_temperature}        ; wait for extruder to reach wipe temp\nM83                                         ; set extruder to relative mode\nG1 E-3 F500                                 ; retract 3mm to reduce drool on fresh filament\nM106 S255                                   ; turn fan on to help drop temp\n; Use M206 below to adjust the nozzle wipe position.\n; X ~ (+)left/(-)right, Y ~ (+)front/(-)back, Z ~ (+)down/(-)up\nM206 X0 Y0 Z0                               ; set nozzle wipe offset\nM117 Wiping Nozzle...                       ; progress indicator message on LCD\nG12                                         ; wiping sequence\nM206 X0 Y0 Z0                               ; reset stock nozzle position ### CAUTION: changing this line can affect print quality ###\nM109 R{material_standby_temperature}        ; wait for extruder to reach probe temp\nM107                                        ; turn off part cooling fan\nM117 Probing...                             ; progress indicator message on LCD\nG29                                         ; start auto-leveling sequence\nM104 R{material_print_temperature_layer_0}  ; start heating to initial printing temp\nM420 S1                                     ; enable leveling matrix\nG1 X0 Y0 Z10 F5000                          ; move up off last probe point\nG4 S1                                       ; pause\nM400                                        ; wait for moves to finish\nM117 Heating...                             ; progress indicator message on LCD\nM190 R{material_bed_temperature_layer_0}    ; wait for bed to reach printing temp\nM109 R{material_print_temperature_layer_0}  ; wait for extruder to reach initial printing temp\nG0 Z{layer_height_0} F1500                  ; move to initial layer height\n; The extruder is in relative mode from the M83 above. LulzBot's stock lines\n; here are \"E6 / E6.5 / E8.5\", and their comments read those as absolute, for\n; 8.5 mm of filament in total. In relative mode the same lines purge 21 mm, and\n; the middle move asks for 207 mm3/s. The hot end melts about 9.5 mm3/s, so the\n; drive gear pushes against solid filament and buckles it.\n; One flow limited prime line replaces them: 8.5 mm of filament over 80 mm of\n; travel in 8.7 s, which is about 6.2 mm3/s.\nG1 X80 Y1 E8.5 F550                         ; prime line along the front edge\nG1 X95 Y1 F3000                             ; quick move to break the prime line off\nM82                                         ; set extruder to absolute mode\nG92 E1                                      ; set extruder position to 1 for a retract\nG1 E0 F1800                                 ; retract 1mm at 30mm/s back to E0\nM117 {jobname}                              ; progress indicator message on LCD\n;Start G-Code End\n"
        },
        "machine_end_gcode": {
            "default_value": "M400                                        ; wait for moves to finish\nM140 S45                                    ; start bed cooling to part removal temp\nM104 S0                                     ; disable hotend\nM107                                        ; disable fans\nG92 E14                                     ; set extruder to 14mm for retract on print end\nM117 Cooling please wait                    ; progress indicator message on LCD\nG91                                         ; relative positioning\nG0 Z10                                      ; move up 10mm\nG90                                         ; absolute positioning\nG1 X145 Y0 F3000                            ; move to cooling position\nM83                                         ; relative extrude\nG0 E-14                                     ; retract 14mm\nM82                                         ; absolute extrude\nM190 R45                                    ; wait for bed to cool down to removal temp\nG1 Y260 F1000                               ; present finished print\nM140 S0                                     ; turn the bed heater off\nM77                                         ; end LCD print timer\nG90                                         ; absolute positioning\nM18 X E                                     ; turn off x and e axis\nM117 Print Complete.                        ; print complete message\n"
        },
